{
  "rules": {
    "meals": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".indexOn": ["date"],
        "$mealId": {
          ".validate": "newData.hasChildren(['id', 'name', 'date', 'items']) && newData.child('id').val() === $mealId",
          "name": {
            ".validate": "newData.isString() && newData.val().matches(/^(breakfast|lunch|dinner)$/)"
          },
          "date": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "items": {
            "$index": {
              ".validate": "newData.hasChildren(['fdcId', 'quantity'])",
              "fdcId": { ".validate": "newData.isNumber()" },
              "quantity": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 10000" },
              "$other": { ".validate": false }
            }
          },
          "id": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
